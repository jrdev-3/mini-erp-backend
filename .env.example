# Configuração do Servidor HTTP (Echo v5)
PORT=8080
APP_ENV=development # development, staging, production

# Conexão com o Banco de Dados (PostgreSQL - Supabase)
# Exemplo de pooler do Supabase: postgres://[user]:[password]@[host]:5432/[db_name]?sslmode=require
DATABASE_URL=postgres://postgres:[SUA_SENHA_AQUI]@[SEU_HOST_SUPABASE_AQUI]:5432/postgres?sslmode=require

# Configuração de Autenticação (Supabase Auth JWT)
# O JWT Secret do Supabase é utilizado para validar as assinaturas dos tokens localmente
JWT_SECRET=sua_chave_secreta_jwt_do_supabase_aqui

# Segurança e Acesso Administrativo Mestre (Super Admin)
# UUID exclusivo reservado para o inquilino de administração do sistema (Control Plane)
ADMIN_TENANT_ID=coloque_aqui_o_uuid_do_tenant_do_super_admin
